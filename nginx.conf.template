# Шаблон, а не готовый конфиг: официальный образ nginx подставляет переменные окружения
# в /etc/nginx/templates/*.template при старте. Порт обязан приходить снаружи — платформы
# вроде Railway передают его в PORT и стучатся именно туда, а зашитый 80 даёт
# «Application failed to respond» при полностью рабочем контейнере.
#
# Переменные самого nginx ($uri, $host) envsubst не трогает: он подставляет только те имена,
# которые реально есть в окружении.
#
# IPv6 обязателен и прописан руками. В образе есть скрипт 10-listen-on-ipv6-by-default.sh,
# который добавил бы его сам, но он отрабатывает ДО envsubst (10- против 20-) и правит ещё
# дефолтный конфиг — наш шаблон затирает его результат. Внутренняя сеть Railway адресуется
# по IPv6: без этой строки прокси не находит апстрим и отдаёт 502 X-Railway-Fallback,
# хотя nginx в логах успешно стартовал.
server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Статический экспорт Next: чистые URL и своя страница 404.
    location / {
        try_files $uri $uri.html $uri/index.html =404;
        # HTML обязан ревалидироваться при каждом заходе. Без явного заголовка браузер
        # кэширует эвристически — берёт долю времени с Last-Modified и отдаёт страницу из
        # кэша, не спрашивая сервер. Выглядит это как «деплой не доехал»: ассеты новые,
        # разметка старая, и никакая перезагрузка не помогает.
        #
        # Здесь именно expires, а не add_header: любой add_header внутри location отменяет
        # наследование серверных заголовков, и страница осталась бы без security-заголовков —
        # ровно там, где они нужнее всего.
        expires -1;
    }
    error_page 404 /404.html;

    # ── Заявка с формы ───────────────────────────────────────────────────────
    # Релей, а не запрос из браузера: токен бота обязан остаться на сервере. В бандле он
    # виден любому через «Просмотр кода», а это полный доступ к боту — писать от его имени,
    # читать getUpdates, увести вебхук. Токен подставляется envsubst при старте контейнера.
    #
    # Клиенту канал доставки не виден вообще. Поэтому здесь mirror, а не прямой proxy_pass:
    # при проксировании ответ отдавала бы вышестоящая сторона, а в её теле лежат и название
    # мессенджера, и имя бота, и id чата — всё это открывалось бы в DevTools, а без JS
    # обычный сабмит уводил бы посетителя прямо на эту страницу. Зеркало же уходит в фоне,
    # его ответ не показывается, и посетитель получает наш собственный 204.
    #
    # Цена решения: статус доставки клиенту неизвестен — форма подтвердит приём, даже если
    # бот настроен неверно. Поэтому после смены реквизитов обязательна проверка реальной
    # отправкой с проверкой чата, а не по виду формы (см. README).
    location = /api/lead {
        limit_except POST { deny all; }
        mirror /internal/notify;
        # Ответ отдаёт петля на себя, а не return 204 рядом с mirror: return завершает запрос
        # на фазе rewrite, а зеркало живёт на фазе precontent — до неё дело просто не доходит,
        # и конфиг молча не отправляет ни одной заявки, оставаясь с виду рабочим.
        proxy_pass http://127.0.0.1:${PORT}/internal/accepted;
        proxy_method GET;
        proxy_pass_request_body off;
        # Петля проходит через тот же сервер и приносит его заголовки, а серверные
        # добавляются к ответу ещё раз — снимаем принесённые, иначе каждый задваивается.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
    }

    # Ответ посетителю: пустой 204 без единого чужого заголовка.
    location = /internal/accepted { return 204; }

    # Известное ограничение: тело запроса уходит в текст как есть, санировать его чистый
    # nginx не умеет. Практический риск — спам в чат, тот же, что у любой открытой формы.
    location = /internal/notify {
        internal;
        proxy_pass https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage;
        proxy_ssl_server_name on;
        proxy_set_header Host api.telegram.org;
        proxy_set_header Content-Type "application/x-www-form-urlencoded";
        # Плюсы вместо пробелов: тело формы urlencoded, и приёмник декодирует text целиком.
        proxy_set_body "chat_id=${TG_CHAT_ID}&text=New+lead+from+the+landing%3A+$request_body";
    }

    # Файлы с хэшем в имени неизменяемы — их можно кэшировать навсегда.
    # Security-заголовки в блоках ниже продублированы намеренно: из-за правила отмены
    # наследования (см. выше) серверные до этих ответов не доходят.
    location /_next/static/ {
        # Только add_header, без expires: вдвоём они шлют два заголовка Cache-Control.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    # Кадры продукта переснимаются вместе с релизом, поэтому кэш короче и с ревалидацией.
    location /assets/ {
        add_header Cache-Control "public, max-age=604800, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Лендинг не встраивается во фреймы и не грузит стороннего кода.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
