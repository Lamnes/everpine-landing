# Шаблон, а не готовый конфиг: официальный образ nginx подставляет переменные окружения
# в /etc/nginx/templates/*.template при старте. Порт обязан приходить снаружи — платформы
# вроде Railway передают его в PORT и стучатся именно туда, а зашитый 80 даёт
# «Application failed to respond» при полностью рабочем контейнере.
#
# Переменные самого nginx ($uri, $host) envsubst не трогает: он подставляет только те имена,
# которые реально есть в окружении.
#
# IPv6 обязателен и прописан руками. В образе есть скрипт 10-listen-on-ipv6-by-default.sh,
# который добавил бы его сам, но он отрабатывает ДО envsubst (10- против 20-) и правит ещё
# дефолтный конфиг — наш шаблон затирает его результат. Внутренняя сеть Railway адресуется
# по IPv6: без этой строки прокси не находит апстрим и отдаёт 502 X-Railway-Fallback,
# хотя nginx в логах успешно стартовал.
server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Статический экспорт Next: чистые URL и своя страница 404.
    location / {
        try_files $uri $uri.html $uri/index.html =404;
        # HTML обязан ревалидироваться при каждом заходе. Без явного заголовка браузер
        # кэширует эвристически — берёт долю времени с Last-Modified и отдаёт страницу из
        # кэша, не спрашивая сервер. Выглядит это как «деплой не доехал»: ассеты новые,
        # разметка старая, и никакая перезагрузка не помогает.
        #
        # Здесь именно expires, а не add_header: любой add_header внутри location отменяет
        # наследование серверных заголовков, и страница осталась бы без security-заголовков —
        # ровно там, где они нужнее всего.
        expires -1;
    }
    error_page 404 /404.html;

    # Файлы с хэшем в имени неизменяемы — их можно кэшировать навсегда.
    # Security-заголовки в блоках ниже продублированы намеренно: из-за правила отмены
    # наследования (см. выше) серверные до этих ответов не доходят.
    location /_next/static/ {
        # Только add_header, без expires: вдвоём они шлют два заголовка Cache-Control.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    # Кадры продукта переснимаются вместе с релизом, поэтому кэш короче и с ревалидацией.
    location /assets/ {
        add_header Cache-Control "public, max-age=604800, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Лендинг не встраивается во фреймы и не грузит стороннего кода.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
